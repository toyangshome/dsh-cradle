# ---- Cradle Discovery Server (Go) -------------------------------------------
# Copy to .env and adjust. Only used by docker compose; the binary reads the
# same variables from its own environment.

# HTTP
CRADLE_ADDR=:8789
CRADLE_LOG_LEVEL=info

# PostgreSQL
POSTGRES_PASSWORD=cradle_dev_password
DATABASE_URL=postgres://cradle:cradle_dev_password@127.0.0.1:5432/cradle?sslmode=disable

# Redis (presence, rate limits, idempotency, hot cards)
REDIS_PASSWORD=cradle_dev_password
REDIS_URL=redis://:cradle_dev_password@127.0.0.1:6379/0

# Shared client token. Empty = the relay accepts anonymous peers (local dev).
CRADLE_TOKEN=

# Operator token for /admin and /admin/v1. Empty = generated at boot and
# printed to the log once.
CRADLE_ADMIN_TOKEN=

# Limits
CRADLE_DB_MAX_CONNS=20
CRADLE_MAX_BODY_BYTES=262144
CRADLE_AUTO_MIGRATE=true
